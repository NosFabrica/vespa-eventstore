# Per-pubkey ranking state — NOT an event. The scores projection derives it
# from stored kind-30382s (and their provider mapping) and keeps it current
# through the store's change feed; it is rebuildable from the event corpus at
# any time.
#
# Declared GLOBAL in services.xml so event documents can reference it
# (event.sd's author_ref) and import both tensors into their own ranking:
# one search over `event` ranks ANY kind by the observer's web of trust for
# the doc's author. Global documents replicate to every content node and are
# held in memory — fine at roster scale (10^5..10^6 pubkeys), a capacity
# decision to revisit before multi-node.
#
# Tensor shapes follow Brainstorm (brainstorm_server app/core/vespa.py):
#   influence_scores{service}  = rank (influence*100, 0..100), int8
#   follower_counts{service}   = verified-follower count, float
# KEYED BY THE SERVICE KEY THAT SIGNED THE 30382, never by the observer: an
# observer's kind 10040 is a POINTER to a service, and the store resolves it
# at query time (query(user_q) = {<service>: 1.0}). So a card is one cell,
# a 10040 change is no write at all, and a document's size is the number of
# services that scored the subject, never the number of users who trust them.
# The mapped dimension is still spelled `user{}`: the label is invisible to
# every caller (cells are fed in the short `{key: value}` form; only a tensor
# `remove` names it), and renaming it is a field TYPE change that needs a
# validation override on a global document type — not worth a label.
schema reputation {

    document reputation {

        field pubkey type string {
            indexing: attribute | summary
            attribute: fast-search
        }

        field influence_scores type tensor<int8>(user{}) {
            indexing: attribute
        }

        field follower_counts type tensor<float>(user{}) {
            indexing: attribute
        }
        # THE BEST RANK ANY OBSERVER GIVES THIS AUTHOR — the max over the
        # influence_scores cells, kept as a scalar so the child events can
        # import it (event.sd's author_max_rank) and a relevance search can
        # carry `author_max_rank >= T`: the trust descent's rung, which makes
        # Vespa walk the trusted authors' documents instead of a common word's
        # postings, and which the client PROVES is the exact page with
        # (TrustDescent). An upper bound on the author's rank under every
        # observer, which is what makes excluding by it sound. Whole-document
        # writes carry the max of their cells; the cell path raises it in the
        # same update as the cell that overtakes it (MaxRankCache); a store
        # fed before this field existed is walked once (MaxRankBackfill).
        # fast-search: the range is meant to DRIVE the query.
        field max_rank type int {
            indexing: attribute | summary
            attribute: fast-search
        }
    }
}
