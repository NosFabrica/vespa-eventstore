# One live Nostr event per document (docid = event id) — the unit of the
# store and the recall surface for NIP-50 filters.
#
# The NIP-01 fields are stored LOSSLESSLY so the complete signed event can be
# reconstructed and served back on a REQ: the signature is over the canonical
# serialization of these exact values, so clients can re-verify what we serve.
# `tags` keeps the exact JSON array; `tag_index` is the derived, queryable form
# ("<letter>:<value>", single-letter tag names only — the space NIP-01 filters
# can address) and is NOT lossless. Do not reconstruct events from tag_index.
#
# SEARCH is per-kind: the store's extractors populate kind-specific fields
# (kind 0 fills the Brainstorm profile group; other kinds fill the generic
# tiers). The groups are LARGELY disjoint per kind, so every scoring function
# zeroes out on docs of the other kinds — one rank profile serves a mixed
# kinds filter with a plain SUM, no kind dispatch, and each doc is ranked by
# its own kind's equations weighted by the observer's web of trust imported
# from the `reputation` parent document. A kind MAY also fill a profile ROLE
# column when it carries that data (an app handler fills the whole profile
# group; a repo/podcast/stream fills `website`); the composites combine the
# groups with max()/SUM, so that deliberate overlap stays well-defined.
#
# Profile fields + equations ported VERBATIM from Brainstorm's
# brainstorm-k8s charts/brainstorm/vespa-app doc.sd (2026-07; operator-
# provided) — the §12 multiplicative-trust default and all sort alternates —
# plus their 2026-07-30 prefix/fuzzy fix (brainstorm-k8s#3 +
# brainstorm_server#64: the *_parts/*_tokens attributes and the near tier).
# Two mechanical changes: the trust tensors are IMPORTED from the reputation
# parent (author_influence_scores / author_follower_counts) instead of living
# on the doc, and the generic tier group extends each composite so
# non-profile kinds ride the same profiles. Query side:
# brainstorm_server app/core/vespa.py + vespa_query.py.
schema event {

    document event {

        # The exact-match filter attributes (id/pubkey/owner/tag_index) share two
        # settings beyond fast-search:
        #  - `match: cased`. Vespa string attributes match UNCASED by default,
        #    which silently diverged from NIP-01/SQLite semantics (tag values and
        #    hex compare by exact bytes; SQLite's tag_hash is case-sensitive):
        #    a stored `t:MixedCase` matched a `#t:["mixedcase"]` filter. Cased
        #    matching restores byte equality — and agrees with the in-memory
        #    reference and the SQLite store, which were always case-sensitive.
        #    (Query-side hex is normalized to lowercase by the client, matching
        #    the lowercase hex both stores hold.)
        #  - `dictionary: hash` (requires cased). These fields are only ever
        #    equality/`in`-matched — never range- or prefix-scanned — so the
        #    default B-tree dictionary buys nothing; a hash dictionary makes
        #    each term lookup O(1) instead of O(log #unique-terms). Measured
        #    noise-level at a 30k corpus (B-tree depth is tiny); the headroom is
        #    for real corpora, where unique terms grow with every event (each id
        #    is unique). A/B'd against the B-tree default and `rank: filter`
        #    (rejected: no read win, slower feeds) — see benchmark/README.md.
        field id type string {
            indexing: attribute | summary
            attribute: fast-search
            match { cased }
            dictionary { hash }
        }

        field pubkey type string {
            indexing: attribute | summary
            attribute: fast-search
            match { cased }
            dictionary { hash }
        }

        field created_at type long {
            indexing: attribute | summary
            attribute: fast-search
        }

        field kind type int {
            indexing: attribute | summary
            attribute: fast-search
        }

        # The event's exact tag array as JSON text. Summary-only: reconstruction,
        # never matching.
        field tags type string {
            indexing: summary
        }

        # Derived "<letter>:<value>" pairs for #x filter recall.
        field tag_index type array<string> {
            indexing: attribute | summary
            attribute: fast-search
            match { cased }
            dictionary { hash }
        }

        # Exact event content — reconstruction only. Search never runs against
        # raw content; searchable kinds contribute curated text to the fields
        # below instead (a kind-0's content is a JSON blob).
        field content type string {
            indexing: summary
        }

        field sig type string {
            indexing: summary
        }

        # The pubkey Nostr semantics key off: the gift-wrap recipient for kind
        # 1059, else the author. Deletion and vanish enforcement match on this
        # (SQLite's pubkey_owner_hash).
        field owner type string {
            indexing: attribute | summary
            attribute: fast-search
            match { cased }
            dictionary { hash }
        }

        # NIP-40: derived from the expiration tag at feed time, so the expiry
        # sweep AND the never-serve-expired query guard are single range
        # clauses. Always written — Long.MAX_VALUE means "never expires" (an
        # absent numeric attribute would read as 0 and break the guard).
        field expires_at type long {
            indexing: attribute | summary
            attribute: fast-search
        }

        # Reference to the author's ranking state (the global `reputation`
        # parent). Written on every doc as "id:reputation:reputation::<pubkey>";
        # the imported tensors below are what let ANY kind rank by the
        # observer's trust in its author.
        field author_ref type reference<reputation> {
            indexing: attribute
        }

        # ---- per-kind search fields (populated by the store's extractors) ----

        # STEMMING IS OFF ON EVERY TEXT FIELD BELOW (`stemming: none`).
        #
        # name/display_name/search_primary always opted out, as proper-noun
        # fields. The rest joined them on 2026-08-05, for a different and
        # bigger reason: Vespa stems a document's index terms with the
        # DOCUMENT's language — which it DETECTS — while a query carries no
        # language and is stemmed as English. Nothing sets either side (no
        # `language` field, no set_language, no model.language), so on a
        # multilingual corpus the two sides silently disagree and a document
        # becomes unreachable by its own words. MEASURED on a live Vespa with
        # a Portuguese note, same words, only the query language differing:
        #     default (en)        futebol 1, esposa 0, crise 0, desabafa 0
        #     model.language=pt   futebol 1, esposa 1, crise 1, desabafa 1
        # Only "futebol" survived — the one word with no suffix the Portuguese
        # stemmer strips. That is not a corner case: it is every non-English
        # note in the corpus, and it is why the 2026-08-05 "divórcio e
        # desabafa" report needed more than the body rung to come back.
        #
        # `stemming: none` makes both sides raw (still folded and tokenized),
        # so they agree by construction, in any language. The alternative —
        # forcing one language on documents — also worked in measurement but
        # pins TOKENIZATION too, which would foreclose ever segmenting CJK
        # properly. What is given up here is nothing measurable: English
        # stemming was already inert on this deployment ("wolf" does not find
        # "wolves", "run" does not find "running"), before and after.
        #
        # STILL BROKEN, deliberately out of scope: CJK BODY text. Segmentation
        # is tokenization, not stemming, and the default linguistics does not
        # segment CJK — a Japanese sentence is one token. Needs a CJK-capable
        # linguistics component. Pinned in RankRegressionIT so a fix trips it.
        # (CJK profile NAMES are unaffected: they ride NearText's raw-byte
        # attributes, which never went through Vespa's tokenizer at all.)
        #
        # UPGRADE COST: this is an indexing change. A FRESH deploy is
        # unaffected — verified: `open(autoDeploy = true)` against an empty
        # Vespa is accepted with no validation override. Redeploying over an
        # EXISTING cluster needs a `validation-overrides.xml` allowing
        # `indexing-change`, and a re-index for old documents to pick up the
        # new terms. NostrSemanticsStore.reindexFullTextSearch will NOT do it
        # — it re-puts only docs whose near-tier arrays drifted, and those are
        # unchanged here; use Vespa's own reindexing.
        #
        # kind 0 — the Brainstorm profile group. Field roles from
        # vespa_query.py: primary = name/display_name/nip05/lud16,
        # affiliation = about/website. Per NIP-24 the deprecated `username`
        # folds into `name` at extraction.
        field name type string {
            indexing: index | summary
            index: enable-bm25
            # Proper-noun field: disable stemming so "Daniels" isn't conflated
            # with "daniel" (Brainstorm §10 typo deep-dive).
            stemming: none
        }

        field display_name type string {
            indexing: index | summary
            index: enable-bm25
            stemming: none
        }

        field about type string {
            indexing: index | summary
            index: enable-bm25
            stemming: none
        }

        field nip05 type string {
            indexing: index | summary
            index: enable-bm25
            stemming: none
        }

        field lud16 type string {
            indexing: index | summary
            index: enable-bm25
            stemming: none
        }

        field website type string {
            indexing: index | summary
            index: enable-bm25
            stemming: none
        }

        # every other searchable kind — the generic tiers. What lands where is
        # the extractor's per-kind decision (docs/v2-sync-proposal.md):
        #   primary    kind 1: subject tag   30023: title
        #   secondary  kind 1: t-tags        30023: summary + t-tags
        #   tertiary   kind 1: content       30023: content
        field search_primary type string {
            indexing: index | summary
            index: enable-bm25
            stemming: none
        }

        field search_secondary type string {
            indexing: index | summary
            index: enable-bm25
            stemming: none
        }

        field search_text type string {
            indexing: index | summary
            index: enable-bm25
            stemming: none
        }

        # Place names, filled systemically from any kind's `location` tags
        # (classifieds, calendar events, pictures/videos). Free-text recall only;
        # geohash-proximity is a separate future column (docs/location-search-column.md).
        field search_location type string {
            indexing: index | summary
            index: enable-bm25
            stemming: none
        }

        # ---- near-tier attribute targets (prefix / fuzzy match fields) ----
        #
        # ATTRIBUTE targets for the direct prefix/fuzzy terms FuzzyWordGroup
        # emits (Brainstorm's 2026-07-30 root-cause: `userInput()` silently
        # drops prefix/fuzzy annotations AND both matchers are rejected
        # against `index` fields — so the annotated forms this schema's
        # queries once carried were silent no-ops). `fast-search` builds the
        # dictionary + posting lists both matchers scan.
        #
        # FED, not derived by an indexing expression: the store computes these
        # via NearText at feed time, because (1) string attributes match raw
        # bytes — Vespa's linguistic folding only applies to index fields — so
        # doc and query must share ONE normalization (NFKD diacritic fold +
        # lowercase) for "jose" to reach "josé"; (2) the tokenizations
        # (camelCase parts, alnum-stripped compound variants, whole-name
        # concatenation, CJK run suffixes) don't fit the indexing language's
        # regex split; (3) a schema-side concatenation of two inputs nulls out
        # when either is missing. CONSEQUENCE: existing docs need a RE-FEED
        # (not just a reindex) to populate these on an already-running corpus —
        # NostrSemanticsStore.reindexFullTextSearch is that re-feed: it
        # compares the stored arrays against a fresh derivation and re-puts
        # any doc whose near tier is missing or stale.
        #
        # TWO granularities, both load-bearing (verified upstream):
        #   *_parts   every word START — camelCase transitions, separator
        #             runs, CJK suffixes — "meme" finds "BitcoinMemeTreasury",
        #             "太郎" finds "中村太郎".
        #   *_tokens  whole tokens plus alnum-stripped and whole-name-joined
        #             variants — "vitorp" finds "VitorPamplona",
        #             "Vitor-Pamplona" AND "Vitor Pamplona".
        #
        # name_parts/name_tokens merge name + display_name; search_primary
        # gets the generic-tier pair; search_secondary gets a TOKENS-only
        # column so hashtags/summaries have prefix reach ("bitco" ->
        # #bitcoin) without parts-splitting prose into the dictionary.
        # about/website/nip05/lud16 get NO near-TIER sibling (a prefix hit on
        # a bio or domain is not name evidence) — but they DO get the
        # weak-tier affil_tokens column below: their exact clauses tokenize
        # emails/URLs into segments ("vitor@vitorpamplona.com" -> vitor,
        # vitorpamplona, com), and any doc a finished word reaches that way
        # must stay reachable while the word is still being TYPED. Without
        # it, as-you-type recall collapsed and snapped back only on the last
        # keystroke ("Vitor Pamp" -> 3 hits, "Vitor Pamplona" -> 10; the
        # 2026-08-02 report pinned by SearchPrefixLadderIT).
        field name_parts type array<string> {
            indexing: attribute
            attribute: fast-search
        }

        field name_tokens type array<string> {
            indexing: attribute
            attribute: fast-search
        }

        field search_primary_parts type array<string> {
            indexing: attribute
            attribute: fast-search
        }

        field search_primary_tokens type array<string> {
            indexing: attribute
            attribute: fast-search
        }

        field search_secondary_tokens type array<string> {
            indexing: attribute
            attribute: fast-search
        }

        # Identity/affiliation segments (nip05, lud16, website, about),
        # NearText.parts-split so email/URL pieces are elements — matched
        # prefix-only (no fuzzy: domains build a huge dictionary and a typo'd
        # domain is not a real query shape), scored by the WEAK tier.
        field affil_tokens type array<string> {
            indexing: attribute
            attribute: fast-search
        }
    }

    import field author_ref.influence_scores as author_influence_scores {}
    import field author_ref.follower_counts as author_follower_counts {}

    # ---- derived trigram views (recall safety-net + tie-breaker) ----

    field name_gram type string {
        indexing: input name | index
        index: enable-bm25
        match {
            gram
            gram-size: 3
        }
    }

    field display_name_gram type string {
        indexing: input display_name | index
        index: enable-bm25
        match {
            gram
            gram-size: 3
        }
    }

    field about_gram type string {
        indexing: input about | index
        index: enable-bm25
        match {
            gram
            gram-size: 3
        }
    }

    field pubkey_gram type string {
        indexing: input pubkey | index
        index: enable-bm25
        match {
            gram
            gram-size: 3
        }
    }

    field search_primary_gram type string {
        indexing: input search_primary | index
        index: enable-bm25
        match {
            gram
            gram-size: 3
        }
    }

    # Discriminative (AND-matched) trigram net for the secondary tier — the same
    # net `about` has (about_gram), extended to every kind's summary/description.
    # INFIX reach, not typo reach: see secondary_text() for the measurement.
    # COST, same measurement: stripping every gram clause cut multi-word query
    # latency ~19-20% at 45k docs (7% on a single common word). The name-side
    # nets earn that back through the weak tier ("dell" -> ODELL, pinned by
    # RankRegressionIT); these two long-text nets have NO test pinning what
    # their recall is worth, and they are ~40% of the gram terms a multi-word
    # query emits. Weigh them before adding more.
    field search_secondary_gram type string {
        indexing: input search_secondary | index
        index: enable-bm25
        match {
            gram
            gram-size: 3
        }
    }

    # Existence-only summary for the bulk-dedup preload: `id` alone. Every
    # field here is an ATTRIBUTE, so Vespa serves this class straight from
    # memory (the docsum "attribute combiner") — the disk summary store is
    # never touched and content-node summary threads stay free for real REQs.
    # The dedup stage asks "which of these 500 ids do I hold" and reads
    # nothing but the id off each hit; filling the full document summary for
    # ~99%-duplicate mirror traffic was the single largest ingest cost (see
    # benchmark/README.md, "Dedup / existence-check A/B"). Adding a summary
    # class is a deploy-only change: no re-feed, no reindex.
    document-summary dedup {
        summary id {}
    }

    fieldset default {
        fields: name, display_name, about, nip05, lud16, website, search_primary, search_secondary, search_text, search_location
    }

    fieldset grams {
        fields: name_gram, display_name_gram, pubkey_gram
    }

    # -----------------------------------------------------------------------
    # PURE-TEXT base profile — Brainstorm's text_relevance, verbatim, plus the
    # tier extension for non-profile kinds. Trust is NOT blended into
    # relevance(); the trust-sorted profiles below inherit everything here.
    # -----------------------------------------------------------------------
    rank-profile text_relevance {

        inputs {
            query(user_q) tensor<float>(user{})
            query(w_gram) double: 5.0
            query(w_display_name) double: 0.2
            query(w_about) double: 0.1
            query(w_about_bonus) double: 0.0
            # Cap on how much the trigram (gram) signal can contribute to a
            # field's text score. Kept below the matchCount unit (100) so a
            # trigram-only match can never outrank a single exact token match.
            query(gram_cap) double: 80.0
            # Per-observer rank floor for filter:rank:gte/gt. Defaults below
            # every real score so the gate in the rank_* profiles below is a
            # no-op unless a query sets it.
            query(min_rank) double: -1000000000.0
            # Match-quality ladder step (§10): spacing between the
            # exact>prefix>1-typo>2-typo tiers within the token-match band.
            query(w_match_step) double: 250.0
            # Multi-word proximity bonus (fieldMatch). Tie-breaker WITHIN a
            # match-quality tier; < w_match_step so it never reorders tiers.
            query(w_proximity) double: 30.0
            # Popularity/trust profiles: the exact>typo match tier sits ABOVE
            # the trust sort so a genuine name match never loses to a
            # more-popular typo/substring hit.
            query(w_pop_token_tier) double: 1000000000.0
            query(w_pop_match_step) double: 10000000.0
            # Near (prefix/fuzzy) tier for the trust-sorted profiles: between
            # the token tier (1e9) and the affiliation tier (1e7). Without it
            # a prefix hit scores bare user_score() — measured upstream five
            # orders of magnitude below a bio-only hit.
            query(w_pop_near_tier) double: 100000000.0
            # Weak tier (bounded infix + hashtag prefix) for the trust-sorted
            # profiles: below near, above affiliation.
            query(w_pop_weak_tier) double: 30000000.0
            # sort_followers' within-tier key scale: w_followers × log(1+count).
            # Even at 1e9 followers the term is ≈ 2.1e6, under every pop-tier
            # gap (1e7+), so the count can order hits inside a tier but never
            # lift one across tiers.
            query(w_followers) double: 100000.0
            # Affiliation tier (§11): a genuine bio OR website-domain token
            # match ranks above gram noise, below real name matches.
            query(w_affil_tier) double: 10000000.0
            query(w_affil_tier_text) double: 550.0
            # Default (search) §12 rewrite: IDF-diluted text × trust — where
            # trust is deliberately strong enough to CROSS text tiers, but
            # only on an overwhelming advantage.
            #
            # At EQUAL trust the four rungs — exact > near > weak >
            # affiliation — still order strictly, each rung ~×5.6 the one
            # below (Brainstorm measured 126 bio-only accounts above the
            # account literally named "coffee" before rungs existed at all).
            # The bio band is SHARED with the body/location rung
            # (tier_body_match(), max()'d into the same weight, not summed),
            # so a kind has four rungs whichever group it fills:
            #     bio  band    = 550 + ~130 (about fallback)
            #     weak floor   = w_weak_tier   =      4 000   (~×5.7 bio)
            #     near floor   = w_near_tier   =     23 000   (~×5.75 weak)
            #     exact floor  = w_name_tier + 100 = 130 100  (~×5.65 near)
            # ACROSS trust, wot_mult() (convex: 1 + trust-delta^w_wot_pow)
            # lets a lower rung overtake the rung above when its trust-delta
            # ratio exceeds (rung ratio)^(1/w_wot_pow) — at the shipped 2.7
            # ≈1.9× per rung, ≈7.6× for the full bio→name gap (×236).
            # Calibrated against the 2026-08-02 "odell" report (the rank case
            # in benchmark/rank_cases.json), which bounds the threshold from
            # BOTH sides: the observer's 97-trust CITADEL DISPATCH bio
            # mention (delta 95) must beat the trust-13 accounts NAMED odell
            # (delta 11; 95/11 ≈ 8.6 > 7.6 ✓); a 77-trust bio mention must
            # NOT beat them (75/11 ≈ 6.8 < 7.6 ✓ — a name match only falls
            # to a bio mention on near-top trust, though a near-FLOOR name
            # match, trust ≤ ~4, still falls behind everyday ~20+-trust bio
            # mentions); and nothing may beat the 93-trust exact ODELL
            # (95/91 is nowhere near 7.6). The window pins w_wot_pow to
            # ~2.55..2.85; 2.7 splits the margin. The old
            # log-concave curve spanned 1.0→~5.6 — under every rung ratio —
            # so trust could NEVER cross a tier and the 97-trust bio mention
            # sat below every name squatter. Re-derive the crossing
            # thresholds on any change to the rung weights, w_affil_tier_text,
            # w_about, gram_cap, w_wot or w_wot_pow. Caveat: w_identity ×
            # identity_text() is unbounded and sits outside this ladder — a
            # near hit that also matches a UNIQUE nip05 handle can cross into
            # the exact band, which is intended (a unique-handle match is
            # itself an exact signal, §12.1).
            query(w_name_tier) double: 130000.0
            # w_near_tier: a PREFIX or FUZZY hit on the *_parts/*_tokens
            # attributes ("Ode"/"Odel" -> ODELL), scored below an exact
            # whole-token match and above everything else. 0 disables the
            # near tier without touching the query side.
            query(w_near_tier) double: 23000.0
            # w_weak_tier: the bounded weak-partial signals — an AND-of-
            # trigrams INFIX hit on a name ("dell" -> ODELL: every trigram of
            # the query must appear, a near-substring test whose selectivity
            # grows with query length) or a hashtag/summary token PREFIX
            # ("bitco" -> #bitcoin via search_secondary_tokens). Still name-
            # side evidence, so above bio mentions; far weaker than an
            # anchored prefix or a budgeted typo, so below near.
            query(w_weak_tier) double: 4000.0
            # Same tiers for the pure-text relevance(), which has NO trust
            # multiply, so the ladder is plain: exact 1100 > near 700 >
            # weak 620 > affiliation 550 > gram (<= gram_cap 80).
            query(w_near_tier_text) double: 700.0
            query(w_weak_tier_text) double: 620.0
            # ---- second-phase precision signals (Meilisearch's "words" and
            # "exactness" rules + within-near ordering). Computed ONLY in the
            # second phase over the top rerank-count hits — fieldMatch is a
            # per-hit positional analysis, and elementCompleteness walks the
            # matched elements; neither belongs in a first phase that scores
            # every match.
            #     w_words       reward for matching MORE of a multi-word query
            #                   (fieldMatch queryCompleteness, 0..1) —
            #                   Meilisearch's #1 "words" rule
            #     w_exactness   reward when the query covers the WHOLE field
            #                   ("Ode" the full name above "Ode Fan Club";
            #                   fieldMatch fieldCompleteness, 0..1)
            #
            # THE BOOST CANNOT CROSS A BAND, whatever its weight: both
            # features read fieldMatch over name/display_name/search_primary —
            # INDEX fields only the EXACT clauses reach. A near hit lands on
            # the *_parts/*_tokens ATTRIBUTES, a weak hit on the *_gram
            # fields, an affiliation hit on about/website; fieldMatch reads 0
            # on all three, so a non-zero boost implies any_token_match()=1.
            # The boost only ever lifts a hit that is ALREADY in the top band,
            # relative to the rest of that band. (The original 60+40=100 was
            # sized against the smallest equal-trust inter-band gap — near
            # floor 23000 minus weak ceiling 4080 = 18920 — a bound this
            # argument shows was never the binding constraint.)
            #
            # What the budget must actually clear is the WITHIN-band tail the
            # boost is there to overrule: primary_text() plus the UNCAPPED
            # 0.4·secondary_text() + 0.15·bm25(search_text) that tier_text()
            # sums. That tail runs to a few hundred points for a doc carrying
            # the term in title AND hashtags AND body, while the only term
            # rewarding a one-token field is bm25/pow(fieldLength,1.5) —
            # single digits. 100 lost that race (the 2026-08-05 "amethyst"
            # report: an app handler NAMED Amethyst under three docs that
            # merely mention it, same author, same trust).
            query(w_words) double: 60.0
            query(w_exactness) double: 40.0
            # The text profiles' band gaps are only ~70-80 wide. The boost
            # can't cross them either (see above), but relevance() has no
            # trust multiply and its within-band tail is the same handful of
            # bm25 points, so the modest scaled budget still clears it:
            # 100 × 0.25 = 25.
            query(w_precision_scale_text) double: 0.25
            # The `search` profile's OWN precision weights. Two things force a
            # separate pair from w_words/w_exactness:
            #  - SCALE. Its bands are text_score() × wot_mult(), and the boost
            #    rides in multiplied by the same wot_mult (see the second
            #    phase there) so the boost-to-band ratio is trust-invariant.
            #    Added RAW, as it was until 2026-08-05, the effective weight
            #    is w_exactness/wot_mult() — 40 points at the trust floor,
            #    0.00017 at trust 100 (1+98^2.7 ≈ 237000). The rule was dead
            #    for every author anyone actually trusts, which is backwards.
            #  - HEADROOM. Multiplied bands are ~130000 wide against the text
            #    profile's 1100, so the same ratio buys a budget three orders
            #    of magnitude larger — enough to overrule the bm25 tail
            #    outright instead of losing to it by single digits.
            # 3000+6000 = 9000 is ~7% of the token band: decisive against the
            # tail, invisible next to the order-of-magnitude moves trust makes
            # (a 13-trust name match sits ~650× a 0-trust one). Only
            # w_exactness_pop separates docs on a SINGLE-word query — both
            # read queryCompleteness 1.0 — so it carries the larger half.
            query(w_words_pop) double: 3000.0
            query(w_exactness_pop) double: 6000.0
            # w_perfect_pop — the PERFECT-MATCH rung. The pair above is a
            # tie-breaker, and a tie-breaker is the wrong shape: wot_mult() is
            # convex, so near the top of the 0..100 scale a ONE-POINT trust
            # difference is worth more than the whole 9000. d(score)/score =
            # w_wot_pow × Δtrust/(trust − min_rank): at trust ~97 that is
            # 2.7/95 ≈ 2.8% per point, against the 3.8% the pair can offer.
            # Both 2026-08-05 reports land exactly there — a trust-100 article
            # titled "…Join Avi Burra's Journey to Paraguay!" over the
            # trust-98 profile Avi Burra (+5.7% from trust), a trust-97 video
            # titled "…| Jon Gordon" over the trust-96 profile Jon Gordon
            # (+2.9%). A perfect match has to be a RUNG that enters the
            # crossing calculus, not a nudge that a rounding error in trust
            # out-buys.
            #
            # BOUNDED ABOVE by the calibrated bio→name crossing (see
            # query(w_name_tier)): the rung lifts the NAME band, so it widens
            # the bio→name ratio and raises the trust advantage a bio mention
            # needs to cross. The odell case pins the tightest point — the
            # 97-trust bio mention must stay above the 13-trust "ODELL mirror"
            # — and mirror is a HALF match (perfect_match 0.5), so the ceiling
            # falls out of its total boost:
            #     bio band × wot_mult(97) / wot_mult(13) − mirror_text
            #       = 550.0 × 218601 / 648.6 − 130115 = 55153 max boost
            #     w_perfect_pop ≤ (55153 − w_words_pop − w_exactness_pop/2) / 0.5
            #       = 98306
            # MEASURED, not estimated: the bio band is 550.0 (w_affil_tier_text
            # plus a w_about fallback that rounds to nothing here) — an earlier
            # pass read the "550 + ~130" note at query(w_name_tier) as a band of
            # 680, put the ceiling at ~185000, and shipped 100000, which flipped
            # the odell pin by 0.45% on a live Vespa. Trust the run, not the
            # arithmetic. 80000 sits 19% under the measured ceiling (5.2% margin
            # on the pin itself) and still gives a perfect match +26..37% over a
            # long-title partial across all five 2026-08-05 reports.
            #
            # The rung is multiplied by trust like every other, so it buys
            # exactness headroom without buying spam any: a trust-3 perfect
            # match stays four orders of magnitude below a trust-50 partial.
            # RE-MEASURE THIS CEILING (do not re-derive it on paper) if
            # w_affil_tier_text, w_about, w_wot_pow or the tier weights move.
            query(w_perfect_pop) double: 80000.0
            # Word count as TYPED, sent by EventYql on every search with terms
            # (see the n_words comment there). 1.0 is the fail-safe default: a
            # sender that omits it degrades perfect_match() to "the field is
            # covered by whatever matched", never to a divide-by-zero, and the
            # order factor switches off — the same behaviour a genuine
            # single-word query gets.
            query(n_words) double: 1.0
            # Floor under order_factor(): how much of the perfect-match rung a
            # RIGHT-WORDS-WRONG-ORDER field keeps. 0 would make order absolute
            # ("Gordon Jon" scores as if it never matched the band at all,
            # which overstates a real-world naming difference — "Pamplona
            # Vitor" is the same person). 0.5 halves the rung, enough to put
            # the correctly-ordered field first at equal trust while leaving
            # the reversed one comfortably inside the token band.
            query(w_order_floor) double: 0.5
            query(w_identity) double: 50.0
            query(w_wot) double: 1.0
            # Exponent of wot_mult()'s trust curve. Sets how much trust
            # advantage crosses a text tier: the trust-delta ratio needed to
            # overtake the rung above is (rung ratio)^(1/w_wot_pow) — see the
            # ladder derivation at query(w_name_tier). 2.7 calibrates the
            # full bio→name gap (×236) to a ~7.6× advantage; 1.0 (linear)
            # pushes the same crossing past the 0..100 scale, i.e. trust is
            # back to (almost) never reordering tiers.
            query(w_wot_pow) double: 2.7
            # Discard hits whose text_score is below this BEFORE the trust
            # multiply — kills weak gram-only noise so trust can't float it.
            #
            # 50 -> 100 (Brainstorm 2026-07-30): 50 sat INSIDE the gram band.
            # The client drops w_gram 8.0 -> 2.0 the moment the shortest query
            # word reaches 4 characters, collapsing gram-only scores from
            # ~60-90 to ~15-25 — so the cutoff deleted entire result sets at
            # exactly 4 chars ("Odel" -> zero results; "VitorP" dropped while
            # "VitorPa" ranked #1). Now that prefix/typo hits score
            # w_near_tier instead of a gram score, nothing real lives down
            # there: 100 sits ABOVE the gram-only ceiling (gram_cap 80 + the
            # about fallback ~13 ≈ 93) and BELOW every real tier (affiliation
            # 550, near 4000). Corpus-dependent (bm25 scales with corpus
            # statistics) — re-check against real data after a reindex.
            #
            # "Nothing real lives down there" is a claim about RUNGS, and it
            # held only because every column HAD one — which search_text and
            # search_location did not until 2026-08-05. Their bare
            # query(w_content)/query(w_location) × bm25 tops out in the low
            # tens, so every body-only hit landed under this cutoff and was
            # deleted. Any column added to text_score() as bare bm25, with no
            # rung of its own, inherits that bug — see tier_body_match().
            #
            # This value is now ALSO the floor under a real match
            # (floored_text_score), so the failure mode of forgetting a rung
            # is "ranks last" rather than "vanishes". Raising it therefore
            # raises the floor band with it; the two must stay one number, or
            # the gap between them reopens exactly the hole the floor closes.
            query(text_score_cutoff) double: 100.0
            # Tier-group weights (generic-tier extension, non-profile kinds).
            query(w_secondary) double: 0.4
            query(w_content) double: 0.15
            query(w_location) double: 0.3
        }

        # The observer's trust in this doc's AUTHOR, via the reputation parent.
        function user_score() {
            expression: sum(query(user_q) * attribute(author_influence_scores))
        }

        function verified_followers() {
            expression: sum(query(user_q) * attribute(author_follower_counts))
        }

        # Text relevance for the name field — the primary signal.
        # Guard the bm25/fieldLength division against fieldLength=0 (empty
        # field): 0/0 = NaN would propagate through max() in primary_text.
        function name_text() {
            expression {
                matchCount(name) * 100
                + if(fieldLength(name) > 0, bm25(name) / pow(fieldLength(name), 1.5), 0)
                + min(query(w_gram) * bm25(name_gram), query(gram_cap))
            }
        }

        function display_name_text() {
            expression {
                matchCount(display_name) * 100
                + if(fieldLength(display_name) > 0, bm25(display_name) / pow(fieldLength(display_name), 1.5), 0)
                + min(query(w_gram) * bm25(display_name_gram), query(gram_cap))
            }
        }

        # about: IDF-aware only (bm25), no flat matchCount term — rare bio
        # terms find affiliated people, common words don't surface
        # bio-mentioners over name-bearers.
        #
        # The gram term is CAPPED at query(gram_cap), like every other gram
        # term in this schema (2026-08-05 audit). It had been uncapped, and
        # text_score_cutoff derives its own safety from the assumption that
        # none of them are — see the ceiling arithmetic there. `about` alone
        # never actually crossed (query(w_about) is 0.1, so a MEASURED
        # about_text of 282 was worth 28 text points), but leaving one term
        # uncapped keeps the cutoff's justification false, and the identical
        # term on the secondary tier DID cross.
        function about_text() {
            expression {
                bm25(about)
                + min(query(w_gram) * bm25(about_gram), query(gram_cap))
            }
        }

        # name and display_name have EQUAL impact: max, not sum, so the same
        # term isn't double-counted across both fields.
        function primary_text() {
            expression: max(name_text(), display_name_text())
        }

        # about contributes only when NOTHING primary matched (fallback).
        # Near hits gate it too: a doc that matched a name at all — exactly or
        # nearly — is scored by that tier alone (tiers must never stack, or
        # they reorder each other's bands; see affiliation_match).
        function secondary_active() {
            expression: if(has_token_match() > 0 || any_near_match() > 0 || weak_match() > 0, 0, 1)
        }

        # A "real" token match — an EXACT whole-token hit in an indexed name or
        # identity field; trigram-only recall doesn't feed matchCount, and
        # prefix/fuzzy hits land on the *_parts/*_tokens attributes instead
        # (near_name_match), so this counts exact hits only.
        function has_token_match() {
            expression: if(matchCount(name) > 0 || matchCount(display_name) > 0 || matchCount(nip05) > 0 || matchCount(lud16) > 0, 1, 0)
        }

        # Graded match quality from the labeled query clauses (vespa_query.py
        # _field_clauses): 4=exact, 3=prefix, 2=1-typo, 1=2-typo, 0=gram-only.
        # KNOWN-INERT: itemRawScore does not populate for plain text terms
        # (Brainstorm staging, 2026-06-30) — degrades safely to 0; the coarse
        # has_token_match tier still applies. Kept for the day Vespa populates
        # term raw scores or the verbatim-field rework (§11.1) lands.
        function match_quality() {
            expression: if(itemRawScore(mtch_exact) > 0, 4, if(itemRawScore(mtch_prefix) > 0, 3, if(itemRawScore(mtch_fz1) > 0, 2, if(itemRawScore(mtch_fz2) > 0, 1, 0))))
        }

        # A BODY match with nothing better — the generic-tier twin of
        # affiliation_match(). `search_text` (a note's content, an article's
        # body) and `search_location` are to a non-profile kind exactly what
        # `about` is to a profile, and until 2026-08-05 they were the only
        # matchable columns in this schema with NO rung at all: their entire
        # contribution was query(w_content)/query(w_location) × bm25, single
        # digits to low tens. Against text_score_cutoff (100) that is not a
        # weak score, it is a DELETED one — the `search` profile maps
        # below-cutoff to 0.0 and rank-score-drop-limit removes the hit. Body
        # search was therefore structurally dead under the observer-lensed
        # default: a kind 1 was findable by its NIP-14 subject and its
        # hashtags and by nothing else, and the many kinds whose ONLY indexed
        # column is content (9, 14, 24, 42, 1111, …) were unfindable outright.
        # No arithmetic reaches the cutoff either — 0.15 × bm25 needs
        # bm25(search_text) ≈ 667, where a rare term contributes single digits.
        # (Reported 2026-08-05: a kind 1 reading "Esposa de Vitor Roque pede
        # divórcio e desabafa sobre crise" came back for the query "vitor" —
        # through its #VItor-roque hashtag, the weak tier — but not for
        # "divórcio e desabafa", which is its content verbatim.)
        #
        # Deliberately the SAME rung as the bio band (w_affil_tier_text in the
        # text profiles, w_affil_tier in the trust-sorted ones) rather than a
        # new one: a word in a body is the same KIND of evidence as a word in
        # a bio — long prose, no naming claim — and an equal-height rung with
        # a mutually exclusive gate leaves every RATIO in the ladder
        # derivation at query(w_name_tier) untouched, so nothing needs
        # recalibrating. Gated on every tier above so tiers never stack, and
        # OR'd into the affiliation rung with max() rather than summed: the
        # two groups are disjoint per kind (the argument any_token_match()
        # already rests on), and where a kind does fill both, one rung is what
        # the ladder means.
        function tier_body_match() {
            expression: if(any_token_match() > 0 || any_near_match() > 0 || weak_match() > 0, 0, if(matchCount(search_text) > 0 || matchCount(search_location) > 0, 1, 0))
        }

        # A bio/website affiliation match WITHOUT any name-field token match.
        # Also gated on near hits: without that the tiers STACK and invert the
        # ladder — upstream measured a prefix hit whose bio also matched
        # (700 + 550 = 1250) ranking ABOVE the exact name match (1100).
        function affiliation_match() {
            expression: if(has_token_match() > 0 || any_near_match() > 0 || weak_match() > 0, 0, if(matchCount(about) > 0 || matchCount(website) > 0, 1, 0))
        }

        # Multi-word proximity over the primary fields (0..1): Meilisearch's
        # `proximity` rule. ~1 for single-word queries (harmless); rewards
        # close-together terms on multi-word ones. Tier fields included so
        # titles get the same treatment (generic-tier extension).
        function proximity() {
            expression: max(max(fieldMatch(name).proximity, fieldMatch(display_name).proximity), fieldMatch(search_primary).proximity)
        }

        # Genuine NAME token match (name/display_name only) — nip05/lud16
        # deliberately excluded; they score via identity_text (IDF) so a
        # common domain like primal.net can't flood the name tier.
        function name_match() {
            expression: if(matchCount(name) > 0 || matchCount(display_name) > 0, 1, 0)
        }

        # IDF-aware identity handles: bm25 is tf*IDF, so a token shared by
        # thousands of nip05s (primal, gmail, com) scores ~0 while a unique
        # handle scores high — "the more a word is used, the smaller the score".
        #
        # KNOWN HOLE (2026-08-05 audit, deliberately NOT fixed here). nip05 and
        # lud16 are the last matchable columns with no rung of their own, and
        # the dilution above is meant to push a common-domain match DOWN, not
        # to delete it — but text_score() has a cutoff, so below
        # query(w_identity) × bm25 ≈ 2 it deletes. Worse, matchCount on either
        # field flips has_token_match(), hence any_token_match(), which GATES
        # weak_match() and tier_body_match() — so an identity match also
        # suppresses the affil_tokens weak-tier column that exists for exactly
        # these fields. A doc whose only match is a common handle token
        # therefore scores ~0 — and until floored_text_score() existed, was
        # DELETED for it.
        #
        # The survival half is closed: matchCount on either field answers
        # real_match(), so such a hit is floored at the cutoff and arrives
        # last instead of not at all. What remains is PLACEMENT — identity is
        # the one column still riding the floor net instead of a rung of its
        # own, which also means tierOf reports it as "name" (identity_match
        # implies has_token_match, so the "identity" label is unreachable).
        # The real fix is to make the token band name_match() ||
        # tier_token_match() in BOTH profiles and give identity its own rung,
        # which retires the affiliation_match/affiliation_match_text fork this
        # same asymmetry forced. That MOVES bands (relevance() puts identity
        # in the token band today), so it needs a live A/B — parked in
        # benchmark/rank_cases.json.
        function identity_text() {
            expression: bm25(nip05) + bm25(lud16)
        }

        function identity_match() {
            expression: if(matchCount(nip05) > 0 || matchCount(lud16) > 0, 1, 0)
        }

        # ---- the near (prefix/fuzzy) tier ----
        # matchCount() on the *_parts/*_tokens attributes is the reliable
        # exact-vs-loose separator the inert itemRawScore ladder (§11.1) never
        # delivered: matchCount(name) counts ONLY exact whole-token hits (the
        # index field), matchCount(name_parts)/… count prefix/fuzzy hits.
        # Each near function is gated on its tier's exact match so an exact
        # hit is scored ONCE, by its own tier, and never also collects near.

        # A prefix/fuzzy hit on the profile name attributes (name+display_name).
        function loose_name_match() {
            expression: if(matchCount(name_parts) > 0 || matchCount(name_tokens) > 0, 1, 0)
        }

        function near_name_match() {
            expression: if(name_match() > 0, 0, loose_name_match())
        }

        # The generic-tier twin: prefix/fuzzy on search_primary (titles/subjects).
        function tier_loose_match() {
            expression: if(matchCount(search_primary_parts) > 0 || matchCount(search_primary_tokens) > 0, 1, 0)
        }

        function tier_near_match() {
            expression: if(tier_token_match() > 0, 0, tier_loose_match())
        }

        # Cross-kind composite, like any_token_match(): the groups are
        # disjoint per kind, so max() is exact.
        function any_near_match() {
            expression: max(near_name_match(), tier_near_match())
        }

        # Affiliation gate for the DEFAULT profile only. Identical to
        # affiliation_match() except it gates on name_match() instead of
        # has_token_match() (which ALSO counts nip05/lud16): a doc whose only
        # match is a COMMON nip05 domain (identity_text ~ 0) must not lose the
        # bio-affiliation credit it genuinely earned — with the old gate it
        # could fall under text_score_cutoff and vanish while the same profile
        # without the matching nip05 ranked normally. affiliation_match() and
        # secondary_active() keep the old gate: relevance() and the rank_*
        # profiles are built on them.
        function affiliation_match_text() {
            expression: if(name_match() > 0 || near_name_match() > 0 || weak_match() > 0, 0, if(matchCount(about) > 0 || matchCount(website) > 0, 1, 0))
        }

        # about-fallback gate for the DEFAULT profile: contribute only when
        # nothing better matched (no name, no near, no identity, no
        # affiliation) — same common-nip05 reasoning as affiliation_match_text.
        function secondary_active_text() {
            expression: if(name_match() > 0 || near_name_match() > 0 || weak_match() > 0 || identity_match() > 0 || affiliation_match_text() > 0, 0, 1)
        }

        # ---- the weak tier: bounded infix + hashtag/summary/affil prefix ----
        # matchCount on the *_gram fields only fires for the AND-of-trigrams
        # INFIX net FuzzyWordGroup emits (the unbounded OR net is off): every
        # trigram of the query word must appear in the name, a near-substring
        # test — "dell" reaches ODELL, "ode" (too few trigrams) reaches
        # nothing. search_secondary/search_secondary_tokens carry the
        # hashtag/summary tier, exact and by token prefix ("bitco" ->
        # #bitcoin); affil_tokens carries identity/
        # affiliation segment prefixes ("vitorpamp" ->
        # amethyst@vitorpamplona.com — the as-you-type continuity column).
        # All are real signals with a bound, weaker than an anchored prefix
        # or a budgeted typo — one tier, gated on the tiers above so nothing
        # stacks.

        function infix_gram_match() {
            expression: if(matchCount(name_gram) > 0 || matchCount(display_name_gram) > 0 || matchCount(search_primary_gram) > 0, 1, 0)
        }

        # The secondary tier's rung. BOTH columns, deliberately: the INDEX
        # field is what the exact clause matches, the *_tokens ATTRIBUTE is
        # what the prefix clause matches, and reading only the attribute meant
        # a whole class of genuine exact matches arrived with NO rung — the
        # same deletion tier_body_match() documents, since
        # query(w_secondary) × bm25 does not reach text_score_cutoff either.
        # Three ways the attribute misses a word the index field holds:
        #   * STEMMING — CLOSED as of 2026-08-05, kept here because the shape
        #     is what the other two share. search_secondary used to be stemmed
        #     (`stemming: best`) while the attribute is raw folded bytes, so
        #     "bitcoiners" reached the index and not the prefix column. Every
        #     text field now carries `stemming: none` (see the field
        #     definitions), for a much larger reason — an index term stemmed
        #     by the DOCUMENT's language cannot meet a query stemmed as
        #     English — and that closed this route as a side effect.
        #   * SHORT WORDS. FuzzyWordGroup emits no prefix clause under
        #     MIN_PREFIX_LEN (3 Latin / 2 non-ASCII) and no gram clause under
        #     MIN_AND_GRAMS_TEXT, so "#ai" was reachable by nothing but its
        #     exact clause.
        #   * THE ELEMENT CAP. NearText.tokens stops at MAX_ELEMENTS (48), so
        #     a long summary/description loses its tail from the attribute
        #     while the index field keeps every word.
        # Strictly additive: every doc the prefix column already reached still
        # reaches the same tier at the same weight, so no band moves.
        function secondary_match() {
            expression: if(matchCount(search_secondary) > 0 || matchCount(search_secondary_tokens) > 0, 1, 0)
        }

        # Gated on the bio/website EXACT match: a finished word is trivially a
        # prefix of its own affil_tokens element, and ungated that promoted
        # every exact bio mention out of the affiliation band into weak
        # (RankRegressionIT's "odell" bio case). The column is purely the
        # UNFINISHED-word bridge — the moment the word completes, the exact
        # clauses take over and the doc scores exactly as it did before this
        # column existed. (Identity exacts need no gate here: matchCount on
        # nip05/lud16 already flips any_token_match, which gates weak_match.)
        function affil_prefix_match() {
            expression: if(matchCount(about) > 0 || matchCount(website) > 0, 0, if(matchCount(affil_tokens) > 0, 1, 0))
        }

        function weak_match() {
            expression: if(any_token_match() > 0 || any_near_match() > 0, 0, if(infix_gram_match() > 0 || secondary_match() > 0 || affil_prefix_match() > 0, 1, 0))
        }

        # ---- second-phase precision signals ----
        # Meilisearch's "words" and "exactness" rules, plus within-near
        # ordering. EXPENSIVE: fieldMatch runs a positional analysis per hit
        # and elementCompleteness walks matched elements — these run ONLY in
        # the second phase over the top rerank-count hits (see search / text2),
        # never in a first phase that scores every match. Weights
        # are sized to reorder WITHIN a band, never across (see the w_words
        # comment in inputs).

        # How much of a multi-word query the best primary field matched
        # (0..1). Single-word queries read 1.0 everywhere — a harmless
        # constant within a band.
        function words_coverage() {
            expression: max(max(fieldMatch(name).queryCompleteness, fieldMatch(display_name).queryCompleteness), fieldMatch(search_primary).queryCompleteness)
        }

        # How much of the matched FIELD the query covers (0..1): 1.0 when the
        # query is the whole name — "Ode" the account beats "Ode Fan Club".
        function exactness() {
            expression: max(max(fieldMatch(name).fieldCompleteness, fieldMatch(display_name).fieldCompleteness), fieldMatch(search_primary).fieldCompleteness)
        }

        # NOT here: a within-near ordering by CHARACTER coverage ("Ode" ->
        # "Ode" above "Ode" -> "Odessa"). fieldMatch/elementCompleteness are
        # TOKEN-granular — a prefix hit on a one-token element reads as a
        # complete match either way — so that signal is not expressible with
        # stock rank features; it would need a custom searcher. Within the
        # near band, order falls to primary_text()/trust as before.
        function precision_boost() {
            expression: query(w_words) * words_coverage() + query(w_exactness) * exactness()
        }

        # A PERFECT match on one primary field: the query covers the whole
        # field AND the field covers the whole query. Per-field PRODUCT, then
        # max — deliberately not max(queryCompleteness) × max(fieldCompleteness)
        # the way words_coverage()/exactness() read them, which can take the
        # two halves from DIFFERENT fields and call a doc perfect that matched
        # half the query in a short name and the other half in a long title.
        # Partial credit is the product, so it degrades smoothly: a whole-query
        # match on a 13-token title reads 0.15, a half-query match on a 2-token
        # name reads 0.5, the field that IS the query reads 1.0.
        #
        # NOT fieldMatch's own queryCompleteness (which this shipped with on
        # 2026-08-05 and which was wrong): it divides by every term in the
        # query tree, and FuzzyWordGroup adds synthetic ones — a joined variant
        # at 2+ words, adjacent-pair concatenations at 3+, each emitted twice —
        # that a normally-spelled doc can never match. An exact whole-field
        # match measured 0.667 at two words and 0.25 at three, so the rung was
        # underpaid by a third and got worse the longer the query. matchCount
        # over query(n_words) counts only what the user typed. Clamped because
        # matchCount CAN exceed both bounds: the duplicated pair groups count
        # twice, and a doc may match more terms than the field has tokens.
        #
        # KNOWN LIMIT: a compound-name hit ("JonGordon" for "Jon Gordon") match-
        # es exactly one term — the joined variant — so it reads 0.5, the same
        # as a doc named "Jon". The two are indistinguishable from inside a rank
        # expression (both are matchCount 1 on a 1-token field), and the
        # itemRawScore ladder that could label them is inert (§11.1). 0.5 beats
        # the 0.333 fieldMatch gave it; recall for that shape is SearchPrefix-
        # LadderIT's job, not this rung's.
        # PER FIELD, and every factor read from THAT field — the whole point.
        # Taking each factor's max independently across fields is the bug this
        # function exists to avoid, and re-committing it is easy: the first cut
        # of the order factor below maxed orderness globally while the coverage
        # maxed per field, so a doc whose `name` REVERSED the query kept full
        # credit because its display_name happened to contain the query in
        # order inside a longer string (measured: it outranked the doc that
        # spelled the name correctly). Any new factor goes INSIDE here.
        #
        #   coverage of the QUERY   matchCount / n_words, clamped. matchCount
        #                           counts query ITEMS, so n_words counts items
        #                           too (words + phrases) — see EventYql.
        #   coverage of the FIELD   fieldMatch fieldCompleteness, which is
        #                           TOKEN-granular. matchCount/fieldLength is
        #                           not a substitute: a 2-word PHRASE is ONE
        #                           item matching TWO field tokens, so the
        #                           ratio read 0.5 on a field the phrase covers
        #                           completely — quoted search, the most
        #                           explicit exactness a user can ask for, paid
        #                           half the rung.
        #   order                   see order_of().
        function field_perfect(f) {
            expression: min(1.0, matchCount(f) / max(1.0, query(n_words))) * fieldMatch(f).fieldCompleteness * order_of(f)
        }

        # Word ORDER, for multi-word queries only. fieldMatch(f).orderness is
        # the in-order fraction of matched term pairs, so a field holding the
        # query's words BACKWARDS scores below one holding them as typed
        # ("Gordon Jon" vs "Jon Gordon", which were bit-identical before this —
        # text_score() never carried the w_proximity term relevance() has, so
        # the observer-lensed default profile, the one nearly every search
        # uses, was blind to order entirely).
        #
        # Gated on n_words > 1 and folded INTO field_perfect() per field
        # rather than added beside it. Both deliberate: with one word there are no pairs to
        # order, so orderness is a constant that would buy nothing while eating
        # the odell ceiling — which is a SINGLE-word case, so this gate leaves
        # that calibration untouched by construction. Folding in (rather than a
        # separate additive term) also means order can only ever REDUCE a
        # perfect match, never manufacture headroom.
        function order_of(f) {
            expression {
                if (query(n_words) > 1,
                    query(w_order_floor) + (1.0 - query(w_order_floor)) * fieldMatch(f).orderness,
                    1.0)
            }
        }

        function perfect_match() {
            expression: max(max(field_perfect(name), field_perfect(display_name)), field_perfect(search_primary))
        }

        # The precision rules at the `search` profile's scale — see
        # query(w_words_pop) and query(w_perfect_pop). Kept a separate function,
        # not a scale factor on precision_boost(), so the text profiles'
        # calibration and the multiplied profile's can move independently.
        function precision_boost_pop() {
            expression {
                query(w_words_pop) * words_coverage()
                + query(w_exactness_pop) * exactness()
                + query(w_perfect_pop) * perfect_match()
            }
        }

        # ---- generic-tier extension: the generic tier group (non-profile kinds). ----
        # Same shape as the name math so magnitudes stay cross-kind
        # comparable: an exact title/subject token match ~ an exact name match.
        # All of these are 0 on kind-0 docs (their tier fields are empty),
        # exactly as the profile functions are 0 on non-profile docs — which is
        # why composition below is a plain sum, never an if(kind) dispatch.

        function tier_token_match() {
            expression: if(matchCount(search_primary) > 0, 1, 0)
        }

        function tier_primary_text() {
            expression {
                matchCount(search_primary) * 100
                + if(fieldLength(search_primary) > 0, bm25(search_primary) / pow(fieldLength(search_primary), 1.5), 0)
                + min(query(w_gram) * bm25(search_primary_gram), query(gram_cap))
            }
        }

        # Secondary tier text: bm25 plus its discriminative gram net, extended to
        # every kind's summary/description the way about_text() covers bios.
        # Uncapped, exactly like about_text().
        #
        # That net is an INFIX matcher, NOT the typo net this comment used to
        # claim. Measured on a live Vespa (2026-08-05, 45k-doc corpus): with the
        # AND-gram clauses stripped from the query, typo recall was UNCHANGED
        # (50 vs 50 on a trailing substitution, 35 vs 35 on a middle one — the
        # fuzzy() terms on the *_parts/*_tokens attributes are what recover a
        # typo) while infix recall collapsed 11 -> 0. It could not be otherwise:
        # the net ANDs every trigram of the query word, and a substitution
        # destroys three consecutive trigrams, so the AND can never hold.
        #
        # The gram term is CAPPED at query(gram_cap). Uncapped, this was the
        # one term that let GRAM-ONLY noise cross text_score_cutoff, whose
        # comment claims a gram ceiling of ~93 — arithmetic that silently
        # assumed every gram term is bounded, and two were not.
        #
        # MEASURED on a live Vespa (2026-08-05), docs whose search_secondary
        # contains the query word ONLY as an infix inside a larger token, so
        # the exact clause and the *_tokens prefix clause both miss and the
        # AND-gram net is the only route (real_match 0 on every row):
        #     word            w_gram  text_score uncapped -> capped
        #     bitcoin (5 gr)   2.0        18 - 20            same
        #     bitcoin          8.0        74 - 78            same
        #     extraordinary    2.0        37 - 43            same
        #     extraordinary    8.0      149 - 172  ->  32    CROSSED 100
        # At the real cutoff the last row went from "returned as a hit" to
        # dropped. w_gram flips to 8.0 whenever the SHORTEST word of a query
        # is <= 3 characters (EventYql/leansOnGrams) and then applies to every
        # word, so "de extraordinary" is enough to trigger it — the long word
        # supplies the trigram count and the short one supplies the weight.
        # The cap ceiling is query(w_secondary) x gram_cap = 0.4 x 80 = 32,
        # which is where the capped column lands, exactly as intended.
        #
        # RankRegressionIT is green with the cap: no calibrated case (the
        # odell crossing bounds, amethyst exactness, the perfect-match rung,
        # jack, word order, phrase) moves, because a doc that matches
        # exactly is scored by its own tier and the gram term is a small
        # additive tail on top.
        function secondary_text() {
            expression {
                bm25(search_secondary)
                + min(query(w_gram) * bm25(search_secondary_gram), query(gram_cap))
            }
        }

        function tier_text() {
            expression {
                tier_token_match() * query(w_name_tier)
                + tier_near_match() * query(w_near_tier)
                + tier_primary_text()
                + query(w_secondary) * secondary_text()
                + query(w_content) * bm25(search_text)
                + query(w_location) * bm25(search_location)
            }
        }

        # ---- composites (profile group + tier group; disjoint per kind) ----

        function any_token_match() {
            expression: max(has_token_match(), tier_token_match())
        }

        # Did the query match a REAL column — one of the ten fields the
        # `default` fieldset and FuzzyWordGroup.SEARCH_FIELDS agree on? Keep
        # the list in sync with both; VespaAppTest fails the build if a column
        # the query builder searches is missing here.
        #
        # This is the honest form of the question text_score_cutoff has always
        # been asking. The cutoff separates a real match from gram-only noise,
        # but it asks by PROXY — "is the score big enough" — and the proxy is
        # what broke three times (search_text and search_location had no rung
        # until 2026-08-05, search_secondary's rung read an attribute that can
        # withhold a word the index field holds, nip05/lud16 still have none).
        # Every one of those was a genuine match scored below 100 and DELETED.
        # The gram fields and the near attributes are deliberately absent from
        # this sum: a trigram or prefix hit never sets matchCount on a column,
        # so gram-only noise still answers 0 here and still dies at the cutoff
        # — which is exactly the line the cutoff was drawing at.
        function real_match() {
            expression: if(matchCount(name) + matchCount(display_name) + matchCount(about) + matchCount(nip05) + matchCount(lud16) + matchCount(website) + matchCount(search_primary) + matchCount(search_secondary) + matchCount(search_text) + matchCount(search_location) > 0, 1, 0)
        }

        # text_score() with the cutoff applied only where it belongs: a real
        # match is FLOORED at the cutoff, never dropped. "Ranks last" is what
        # the cutoff's own comment always claimed it did, and what the tier
        # ladder is for; deletion was never the intent for anything that
        # actually matched.
        #
        # The floor IS query(text_score_cutoff), not a weight of its own —
        # deliberately, so this cannot move a single hit that survives today:
        # a surviving doc scores >= the cutoff, and max() is then a no-op on
        # it. The only docs whose score changes are the ones currently mapped
        # to 0.0 and deleted, which arrive at the bottom of the ranking
        # instead. A doc that lands ON the floor has no rung, so it also has
        # no within-band text signal to order it — trust (wot_mult) orders the
        # floor band, which is the right fallback for "we know it matched, we
        # don't know why it's good".
        #
        # A forgotten column is therefore a RANKING bug from here on, not a
        # recall outage. Give every column a real rung anyway — the floor is
        # the net under the ladder, not a rung.
        function floored_text_score() {
            expression: if(real_match() > 0, max(text_score(), query(text_score_cutoff)), if(text_score() < query(text_score_cutoff), 0.0, text_score()))
        }

        # IDF-diluted TEXT score for the default profile — the thing that gets
        # MULTIPLIED by trust. All terms are text; common tokens and gram-only
        # noise stay low so trust can't float them. (Brainstorm text_score()
        # + the tier group.)
        function text_score() {
            expression {
                name_match() * query(w_name_tier)
                + near_name_match() * query(w_near_tier)
                + weak_match() * query(w_weak_tier)
                + primary_text()
                + query(w_identity) * identity_text()
                + max(affiliation_match_text(), tier_body_match()) * query(w_affil_tier_text)
                + secondary_active_text() * query(w_about) * about_text()
                + tier_text()
            }
        }

        # MULTIPLICATIVE trust — NOT additive (additive WoT swamped exactness).
        # 0 below the rank cutoff (server passes min_rank=2), then a CONVEX
        # power boost over the trust delta (w_wot_pow, shipped 2.7).
        # w_wot=0 => pure text.
        #
        # WHY convex, not the concave log this shipped with: the log's whole
        # span was 1.0→~5.6 — below every rung ratio of the tier ladder — so
        # trust could NEVER cross a text tier, and "odell" buried the
        # observer's 97-trust CITADEL DISPATCH (bio: "hosted by ODELL") at
        # #9, under trust-13 accounts NAMED odell (reported 2026-08-02).
        # Powered trust-deltas make the crossing deliberate and calibrated —
        # only an overwhelming (~7.6× for bio→name) trust advantage crosses;
        # see the ladder derivation at query(w_name_tier).
        #
        # The delta is clamped to the served 0..100 provider scale (the store
        # clamps scores to the same bound — TrustRecompute.boundedRank), so
        # the crossing calculus can't be distorted from either side. The
        # clamp is also what keeps the fail-open min_rank default (-1e9)
        # merely degenerate rather than astronomical: it flattens the
        # multiplier to the same 1 + w_wot·100^w_wot_pow constant for every
        # author and the order degrades to pure text (the include:spam
        # regression; the store sends 0.0 for that case). query(min_rank) is
        # therefore ALSO the curve's anchor, not just the gate: a sender that
        # wants "no gate" must pass min_rank=0, never omit the feature.
        function wot_mult() {
            expression: if(user_score() < query(min_rank), 0.0, 1.0 + query(w_wot) * pow(min(max(0.0, user_score() - query(min_rank)), 100.0), query(w_wot_pow)))
        }

        # PURE-TEXT relevance (Brainstorm relevance() + the tier group):
        # token-match band on top, match-quality ladder + proximity within,
        # affiliation above gram noise, bm25 ordering inside each band.
        function relevance() {
            expression {
                any_token_match() * 1100
                + any_near_match() * query(w_near_tier_text)
                + weak_match() * query(w_weak_tier_text)
                + match_quality() * query(w_match_step)
                + max(affiliation_match(), tier_body_match()) * query(w_affil_tier_text)
                + query(w_proximity) * proximity()
                + primary_text()
                + tier_primary_text()
                + query(w_secondary) * secondary_text()
                + query(w_content) * bm25(search_text)
                + query(w_location) * bm25(search_location)
                + secondary_active() * query(w_about) * about_text()
            }
        }

        first-phase {
            expression: relevance()
        }

        match-features {
            user_score
            name_text
            display_name_text
            about_text
            has_token_match
            any_token_match
            near_name_match
            any_near_match
            weak_match
            match_quality
            affiliation_match
            tier_body_match
            itemRawScore(mtch_exact)
            itemRawScore(mtch_prefix)
            itemRawScore(mtch_fz1)
            itemRawScore(mtch_fz2)
            itemRawScore(mtch_affil)
        }
    }

    # -----------------------------------------------------------------------
    # Trust-sorted profiles. All inherit text_relevance (functions, inputs,
    # match-features carry over). Each gates on query(min_rank) by mapping a
    # failing hit to the SENTINEL (-1e9) and letting rank-score-drop-limit
    # (-1e6) drop it; real scores stay far above the sentinel.
    # -----------------------------------------------------------------------

    # Text order with the trust floor applied. The store's filter mapping no
    # longer selects this (with terms the floor rides the query's own profile;
    # without terms recall is served chronologically by recency_gated below) —
    # kept for direct EventQuery API users.
    rank-profile rank_filtered inherits text_relevance {
        first-phase {
            expression: if(user_score() >= query(min_rank), relevance(), -1000000000.0)
            rank-score-drop-limit: -1000000.0
        }
    }

    # Observer-gated plain recall: NIP-01 recency order, low-trust dropped.
    # The store stamps recency_gated on every non-search query with a resolved
    # observer (include:spam opts out) and on the no-terms filter:rank
    # match-all. The score IS created_at, so relevance order = newest first;
    # the sentinel / drop-limit pair removes below-floor authors engine-side.
    # Real timestamps (~1.7e9) sit far above the drop limit, so no live hit is
    # ever dropped by accident.
    #
    # recency_gated_exact is the full-scan variant: every match the filter
    # touches is gated and scored. Exact for every shape, but a bare gated
    # feed query pays ~100ms per million candidate postings — so it serves as
    # the fallback and the unlimited/deep-pagination shape, not the hot path.
    #
    # STANDALONE, not inheriting text_relevance: these are the only trust
    # profiles serving TERMLESS queries on the hot feed path, and inheriting
    # would carry text_relevance's 16 match-features — computed and serialized
    # PER HIT for a query that has no text at all (several even reference
    # query item labels a termless query never emits). The two inputs below
    # therefore mirror text_relevance's declarations — same tensor type, same
    # fail-open min_rank default (below every real score) — keep them in sync.
    rank-profile recency_gated_exact {
        inputs {
            query(user_q) tensor<float>(user{})
            query(min_rank) double: -1000000000.0
        }

        function user_score() {
            expression: sum(query(user_q) * attribute(author_influence_scores))
        }

        first-phase {
            expression: if(user_score() >= query(min_rank), attribute(created_at), -1000000000.0)
            rank-score-drop-limit: -1000000.0
        }
    }

    # recency_gated: the hot-path variant for the dominant REQ shape ("kind 1,
    # limit 50, authenticated"). The match-phase keeps only the ~max-hits
    # newest candidates per node BEFORE the gate runs, so the cost matches the
    # ungated recency profile instead of ranking every posting. If fewer than
    # `limit` trusted hits survive among the kept candidates the response
    # arrives match-phase-degraded and the client reruns on
    # recency_gated_exact — degradation can cost a second query, never a
    # result (see VespaEventIndex.recallRoot). max-hits mirrors the recency
    # profile and is PER CONTENT NODE.
    rank-profile recency_gated inherits recency_gated_exact {
        match-phase {
            attribute: created_at
            order: descending
            max-hits: 20000
        }
    }

    # sort:rank:desc (+ optional filter): trust-sorted WITHIN each match tier —
    # token matches above gram noise, exact>typo bucketing above trust, trust
    # ordering inside a tier (Meilisearch's `typo` over `sort`).
    rank-profile rank_desc inherits text_relevance {
        first-phase {
            expression: if(user_score() >= query(min_rank), any_token_match() * query(w_pop_token_tier) + any_near_match() * query(w_pop_near_tier) + weak_match() * query(w_pop_weak_tier) + match_quality() * query(w_pop_match_step) + max(affiliation_match(), tier_body_match()) * query(w_affil_tier) + user_score(), -1000000000.0)
            rank-score-drop-limit: -1000000.0
        }
    }

    # sort:rank:asc: ascending trust WITHIN each (still-descending) match tier.
    rank-profile rank_asc inherits text_relevance {
        first-phase {
            expression: if(user_score() >= query(min_rank), any_token_match() * query(w_pop_token_tier) + any_near_match() * query(w_pop_near_tier) + weak_match() * query(w_pop_weak_tier) + match_quality() * query(w_pop_match_step) + max(affiliation_match(), tier_body_match()) * query(w_affil_tier) - user_score(), -1000000000.0)
            rank-score-drop-limit: -1000000.0
        }
    }

    # sort:followers — VERIFIED-FOLLOWER-COUNT order within each match tier.
    # Same tier ladder and min_rank gate as rank_desc, but the within-tier key
    # is verified_followers() (the count the observer's `30382:followers`
    # provider attested), not the influence score. The count rides in
    # log-compressed: log is monotonic, so within-tier ORDER is exactly by
    # follower count, while the term stays bounded — w_followers × log(1+1e9)
    # ≈ 2.1e6, far under the smallest inter-tier gap (1e7) — so a mega
    # account can never buy its way across a match tier.
    #
    # HISTORY: this profile name long predates its behavior. Before the §12
    # rewrite it was the default profile; §12 replaced its expression with the
    # text × trust multiply, which left `sort:followers` a silent alias of the
    # default and follower_counts feeding nothing but a match-feature. The §12
    # default now lives on `search` (below) and this profile does what its
    # name — and the NIP-50 token — always said.
    rank-profile sort_followers inherits text_relevance {
        function follower_key() {
            expression: query(w_followers) * log(1.0 + max(0.0, verified_followers()))
        }

        first-phase {
            expression: if(user_score() >= query(min_rank), any_token_match() * query(w_pop_token_tier) + any_near_match() * query(w_pop_near_tier) + weak_match() * query(w_pop_weak_tier) + match_quality() * query(w_pop_match_step) + max(affiliation_match(), tier_body_match()) * query(w_affil_tier) + follower_key(), -1000000000.0)
            rank-score-drop-limit: -1000000.0
        }

        match-features {
            user_score
            verified_followers
            has_token_match
            any_token_match
            near_name_match
            any_near_match
            weak_match
            identity_match
            affiliation_match
            tier_body_match
        }
    }

    # DEFAULT profile (Brainstorm §12, 2026-07-01): IDF-diluted text score
    # MULTIPLIED by the calibrated convex trust curve (wot_mult). Weak text
    # (below text_score_cutoff) and below-cutoff trust (wot_mult()=0) both
    # map to 0 and are dropped. Tune LIVE via query(w_wot)/query(w_wot_pow)/
    # query(w_identity)/query(min_rank)/query(w_name_tier) — rank-config, no
    # redeploy.
    # (This body lived on sort_followers until that profile became a real
    # follower sort; EventYql has always sent `search`, so the default's
    # behavior is unchanged.)
    rank-profile search inherits text_relevance {
        first-phase {
            expression: floored_text_score() * wot_mult()
            rank-score-drop-limit: 0.5
        }

        # Precision pass over the top hits only: the expensive per-hit
        # signals (words rule, exactness) reorder WITHIN a band — the boost is
        # non-zero only for hits already in the token band (see
        # query(w_words_pop)), so band membership is exactly the first
        # phase's. Dropped hits (cutoff / rank-score-drop-limit) never reach
        # this phase.
        #
        # × wot_mult(): the first phase is MULTIPLICATIVE in trust, so a raw
        # additive boost is worth w/wot_mult() text points — 40 at the trust
        # floor, 0.00017 at trust 100. Scaling it by the same multiplier the
        # bands carry makes the boost-to-band ratio trust-invariant, which is
        # what "reorders within a band" was always supposed to mean. The
        # multiply is recomputed here rather than threaded through firstPhase:
        # a tensor dot plus a pow over ≤ rerank-count hits, against the
        # fieldMatch analysis this phase already pays for.
        second-phase {
            expression: firstPhase + precision_boost_pop() * wot_mult()
            rerank-count: 1000
        }

        # Surface the decisive signals so the API/inspector can show WHY a hit
        # ranked where it did (text bands + the trust multiplier). perfect_match
        # earns its place here: since 2026-08-05 it is what orders hits INSIDE
        # the token band, so "why is this above that" is unanswerable without
        # it. It costs nothing extra — the second phase already computes the
        # fieldMatch analysis it reads.
        match-features {
            user_score
            verified_followers
            perfect_match
            name_match
            identity_match
            identity_text
            has_token_match
            any_token_match
            loose_name_match
            near_name_match
            any_near_match
            weak_match
            affiliation_match
            affiliation_match_text
            tier_body_match
            secondary_active_text
            real_match
            text_score
            wot_mult
            name_text
            display_name_text
            about_text
        }
    }

    # `text` is the library's stable name for the pure-text profile NIP-50
    # `sort:text` selects (and the observer-less default) — a pure rename.
    # (`search`, the other stable name, is defined above with the §12 body.)
    rank-profile text inherits text_relevance {
    }

    # TWO-PHASE variant of `text` (A/B under measurement; see
    # docs/two-phase-ranking.html). Phase 1 scores every match with
    # relevance() MINUS its two expensive within-band tie-breakers —
    # fieldMatch proximity (a positional analysis per field per hit) and the
    # match-quality ladder (itemRawScore, currently inert anyway) — which
    # keeps BAND membership exact: the dropped terms (≤ ~280 points) can
    # never cross the 1100-point token-match band gap. Phase 2 re-applies the
    # full tuned relevance() to the top rerank-count hits per node, restoring
    # today's exact within-band order inside the window. Query-time override:
    # `ranking.rerankCount`.
    rank-profile text2 inherits text_relevance {
        function relevance_cheap() {
            expression {
                any_token_match() * 1100
                + any_near_match() * query(w_near_tier_text)
                + weak_match() * query(w_weak_tier_text)
                + max(affiliation_match(), tier_body_match()) * query(w_affil_tier_text)
                + primary_text()
                + tier_primary_text()
                + query(w_secondary) * secondary_text()
                + query(w_content) * bm25(search_text)
                + query(w_location) * bm25(search_location)
                + secondary_active() * query(w_about) * about_text()
            }
        }

        first-phase {
            expression: relevance_cheap()
        }

        second-phase {
            # relevance() restores the full tuned order; the scaled precision
            # boost (the text ladder's gaps are only ~70-80 wide) adds the
            # words/exactness/near-quality rules on top. In-band only.
            expression: relevance() + query(w_precision_scale_text) * precision_boost()
            rerank-count: 1000
        }
    }

    # Limit'd unranked recall: instead of ranking EVERY posting the filter
    # matches (~100ms per million) to keep the newest few, match-phase keeps
    # only the ~max-hits newest candidates DURING matching. The client sends
    # this profile only when limit is far below max-hits (10x margin) and the
    # query's until anchor is recent; the response is marked
    # match-phase-degraded, which the client accepts ONLY when the page is
    # provably exact (full, single node) and otherwise reruns unranked —
    # match-phase can under-deliver on skewed corpora, so a probe-shaped
    # query (a NIP-09 guard's limit-1 lookup) stays exact through that rerun.
    # Counts and groupings never use this profile at all.
    # NOTE: max-hits is PER CONTENT NODE; the client treats any multi-node
    # degraded page as needing the exact rerun.
    rank-profile recency {
        match-phase {
            attribute: created_at
            order: descending
            max-hits: 20000
        }
        first-phase {
            expression: attribute(created_at)
        }
    }
}
