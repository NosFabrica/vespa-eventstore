<?xml version="1.0" encoding="UTF-8" ?>
<!-- ANNOTATED multi-node services.xml example (see docs/scaling.md).

     This file is documentation, not deployed. Start from the bundled
     package's services.xml, then apply your topology as shown here.

     KEEP verbatim from the bundled package:
       * the GC selection on the event document (NIP-40 expiry, engine-side)
       * schemas/ and search/query-profiles/ (taken from the library jar)
       * the containers' <jvm options> (direct-buffer ceiling + cache cap —
         without them a container dies under load, see below)
       * the BatchFeedHandler, on the cluster that serves <document-api />
     CHANGE for your deployment:
       * node lists (hostaliases come from your hosts.xml / infrastructure)
       * redundancy / searchable-copies
       * resource limits (the bundled dev override is REMOVED here: size disks
         instead, and let Vespa's default 80%/85% feed-block guard protect you)
       * numthreadspersearch (1 = concurrent-serving throughput; raise for a
         latency-critical few-big-queries deployment)                          -->
<services version="1.0">

  <!-- Config servers are declared in your deployment tooling (3 for HA). -->

  <!-- TWO container clusters, one per role (docs/scaling.md, "Feed and query
       containers"). Neither holds data, so they scale and fail independently:
       a feed burst's parsing and buffers, or a container that dies of them,
       no longer takes query serving with it. Open the store with each list:
         VespaEventStore.open(
             url = "http://query-0:8080", autoDeploy = false,
             feedEndpoints = listOf("http://feed-0:8080", "http://feed-1:8080"),
             queryEndpoints = listOf("http://query-0:8080", "http://query-1:8080"),
         )
       A deployment that keeps ONE cluster declares <search />, <document-api />
       and the handler together, as the bundled package does, and passes
       `endpoints` instead. -->

  <!-- FEED: everything under /document/v1 (puts, updates, removes, the get by
       id, every visit) plus the batch handler. Indexing runs here too (see
       <document-processing> in the content cluster below). -->
  <container id="feed" version="1.0">
    <document-api />
    <document-processing />
    <!-- KEEP, here and not on the query side: the handler dispatches through
         THIS container's own document API (bundled services.xml). -->
    <handler id="com.nosfabrica.vespa.eventstore.bundle.BatchFeedHandler" bundle="eventstore-bundle">
      <binding>http://*/eventstore/v1/feed</binding>
    </handler>
    <nodes>
      <!-- KEEP: the direct-buffer settings are AVAILABILITY config, not tuning.
           Vespa derives a ~208 MiB direct-memory ceiling and runs the container
           with -XX:+ExitOnOutOfMemoryError; because jrt reads into heap buffers,
           the JDK's per-thread cache of temporary DIRECT buffers retains them at
           high-water size and saturates that ceiling under load — one failed
           reservation then kills the container. Dropping either flag brings
           that back; the full argument is in the bundled services.xml. Raise
           the ceiling further if your nodes are busier, and add
           allocated-memory below to size the HEAP for your hardware (the
           bundled package leaves it at Vespa's 1536m default, which is a
           laptop's number, not a cluster's). Both clusters carry them. -->
      <jvm options="-XX:MaxDirectMemorySize=512m -Djdk.nio.maxCachedBufferSize=262144" />
      <!-- Two+ containers: pass ALL of them as feedEndpoints so the feed
           client spreads its HTTP/2 connections across them. -->
      <node hostalias="feed-0" />
      <node hostalias="feed-1" />
    </nodes>
  </container>

  <!-- QUERY: every /search/ request — client reads, counts, and the writer's
       own admission probes, which are most of a mirroring writer's requests. -->
  <container id="query" version="1.0">
    <search />
    <nodes>
      <!-- KEEP: the same direct-buffer settings as the feed cluster; the
           summary reads that saturated them on staging are served here. -->
      <jvm options="-XX:MaxDirectMemorySize=512m -Djdk.nio.maxCachedBufferSize=262144" />
      <node hostalias="query-0" />
      <node hostalias="query-1" />
    </nodes>
  </container>

  <content id="content" version="1.0">
    <!-- Two copies of every event: one node can fail without data loss.
         searchable-copies=1 keeps only the active copy indexed (half the
         memory); a failover then reindexes before serving that data. -->
    <redundancy>2</redundancy>
    <engine>
      <proton>
        <searchable-copies>1</searchable-copies>
      </proton>
    </engine>

    <documents garbage-collection="true">
      <!-- With more than one container cluster, name the one that runs
           indexing, so it is the feed side and never the query side. -->
      <document-processing cluster="feed" />
      <!-- KEEP: NIP-40 expiry as a server-side constraint (docs/server-side-constraints.md). -->
      <document type="event" mode="index" selection="event.expires_at &gt; now()" />
      <!-- KEEP: global so event docs can import the trust tensors (parent/child). -->
      <document type="reputation" mode="index" global="true" />
    </documents>

    <nodes>
      <!-- The corpus splits ~evenly across these; add nodes and redeploy to
           grow — Vespa redistributes online. For query-throughput scaling,
           see grouped distribution (<group> elements) in the Vespa docs. -->
      <node distribution-key="0" hostalias="content-0" />
      <node distribution-key="1" hostalias="content-1" />
      <node distribution-key="2" hostalias="content-2" />
      <node distribution-key="3" hostalias="content-3" />
    </nodes>

    <config name="vespa.config.search.core.proton">
      <feeding>
        <concurrency>1.0</concurrency>
      </feeding>
      <!-- KEEP for relay serving: one matching thread per query keeps cores
           saturated with independent queries (throughput-optimal). -->
      <numthreadspersearch>1</numthreadspersearch>
      <!-- KEEP: cap the transaction log so it flushes/prunes long before it
           can fill a disk mid-sync (see the bundled services.xml comment). -->
      <flush>
        <memory>
          <maxtlssize>4294967296</maxtlssize>
        </memory>
      </flush>
    </config>
  </content>

</services>
